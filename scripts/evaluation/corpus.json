{
  "schema_version": 1,
  "description": "Synthetic multi-project reliability study; no business source or personal data.",
  "cases": [
    {
      "id": "python-orders",
      "language": "Python",
      "question": "Is cancellation always blocked when an order still has active services? Explain the conditions, configuration limits and what historical cancelled records prove. No live business database is provided.",
      "symbol_query": "cancellation_allowed",
      "search_pattern": "cancellation_allowed|block_active_services|import_legacy_order|legacy_import",
      "expected_files": ["policy.py", "settings.py", "history.py", "records.json"],
      "critical_facts": [
        {"id": "conditional_rule", "patterns": ["subscription", "block_active_services"], "source": "policy.py"},
        {"id": "configuration", "patterns": ["block_active_services"], "source": "settings.py"},
        {"id": "historical_anomaly", "patterns": ["legacy", "import"], "source": "history.py"},
        {"id": "counterexample", "patterns": ["single", "active"], "source": "records.json"}
      ],
      "forbidden_unqualified_conclusions": ["cancellation is always blocked", "all orders with active services are blocked"],
      "expected_counterexamples": ["single", "legacy"],
      "unresolved_business_decisions": 0
    },
    {
