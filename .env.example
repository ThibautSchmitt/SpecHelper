BIND_ADDRESS=127.0.0.1
PORT=3000
# Leave blank: generated automatically in persistent protected volumes.
DJANGO_SECRET_KEY=
RUNTIME_TOKEN=
POSTGRES_PASSWORD=replace-with-a-local-database-password
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Remote access requires a shared team password and HTTPS.
# Set a Django-encoded hash, or a protected /data/... password file (minimum 16 characters).
SPECHELPER_ACCESS_PASSWORD_HASH=
SPECHELPER_ACCESS_PASSWORD_FILE=
SPECHELPER_LOCAL_ONLY=1
SPECHELPER_REQUIRE_HTTPS=0
# Enable only when the backend is reachable exclusively through your trusted TLS proxy.
SPECHELPER_TRUST_PROXY=0
SPECHELPER_AUDIT_RETENTION_DAYS=30
# Keep this key separate from PostgreSQL backups; do not change it without re-encryption.
ENCRYPTION_KEY_FILE=/data/encryption.key
